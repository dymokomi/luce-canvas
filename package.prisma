#prisma 4.0
def package "luce-canvas" {
    str owner = "dymokomi"
    str version = "0.1.7"
    str kind = "package"
    str language = "luce-base"
    str description = "The canvas engine for Luce image editors: documents as immutable, shared 256-pixel GPU tiles, built to keep very large canvases fast."
    str readme = "README.md"

    def export "tiles" {
        str module = "luce_canvas.tiles"
    }

    def export "half" {
        str module = "luce_canvas.half"
    }

    def export "pyramid" {
        str module = "luce_canvas.pyramid"
    }

    def export "tile_cache" {
        str module = "luce_canvas.cache"
    }

    def dependency "luce-gpu" {
        str owner = "dymokomi"
        str version = "^0.1.13"
        str path = "../luce-gpu"
    }

    def dependency "luce-raster" {
        str owner = "dymokomi"
        str version = "^0.1.1"
        str path = "../luce-raster"
    }

    def dependency "luce-std" {
        str owner = "dymokomi"
        str version = "^0.1.1"
        str path = "../luce-std"
    }
}
